---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionDivider from '../components/SectionDivider.astro';

interface Props {
  title: string;
  description: string;
  /** Page heading, rendered in the dark hero band. */
  heading: string;
  /** Kicker above the heading. */
  eyebrow: string;
  /** One-line summary under the heading. */
  intro: string;
  /** Effective / last-updated date, displayed verbatim. */
  updated: string;
}

const { title, description, heading, eyebrow, intro, updated } = Astro.props;
---

<Layout title={title} description={description}>
  <Header home="/" />
  <main>
    <!--
      Note: no [data-anim] on any content below. Those attributes set opacity:0 in CSS
      and only clear it via IntersectionObserver, which would hide this text from any
      non-JS fetch — including A2P 10DLC carrier verification tooling.
    -->
    <section class="pt-[200px] pb-24 px-6 bg-[#141C2B]">
      <div class="max-w-[820px] mx-auto text-center">
        <p class="uppercase text-xs font-bold tracking-[3px] text-[#B8943F] mb-6">
          {eyebrow}
        </p>
        <h1
          class="text-[2.25rem] md:text-[3.25rem] font-bold leading-[1.15] mb-6 tracking-tight font-serif text-white"
        >
          {heading}
        </h1>
        <div class="w-16 h-[3px] bg-[#B8943F] mb-8 mx-auto"></div>
        <p class="text-lg text-white/60 leading-relaxed max-w-[640px] mx-auto">
          {intro}
        </p>
      </div>
    </section>

    <SectionDivider type="curve" fillColor="#FAFAF7" bgColor="#141C2B" />

    <section class="bg-page-bg px-6 py-20">
      <div class="max-w-[820px] mx-auto">
        <p
          class="text-xs font-bold uppercase tracking-[2px] text-muted pb-6 mb-12 border-b border-card-border"
        >
          Effective {updated} &middot; Last updated {updated}
        </p>

        <div class="legal-prose">
          <slot />
        </div>

        <div
          class="mt-16 pt-10 border-t border-card-border text-sm text-muted leading-relaxed"
        >
          <p class="font-semibold text-navy mb-2">
            The Engine Room Financial Group
          </p>
          <p>456A Central Ave Suite 115, Cedarhurst, NY 11516</p>
          <p>
            <a href="tel:5168780015" class="text-accent hover:underline"
              >(516) 878-0015</a
            >
            &middot;
            <a
              href="mailto:getintouch@TheERFG.com"
              class="text-accent hover:underline">getintouch@TheERFG.com</a
            >
          </p>
        </div>
      </div>
    </section>

    <SectionDivider type="curve" fillColor="#141C2B" bgColor="#FAFAF7" />
  </main>
  <Footer home="/" />
</Layout>

<style is:global>
  /* ========================================
     LEGAL PROSE
     Brand-styled long-form legal copy. Deliberately animation-free so every
     clause is present and visible in the raw HTML.
     ======================================== */
  .legal-prose {
    color: #1a1f2e;
  }

  .legal-prose > section + section {
    margin-top: 3rem;
  }

  .legal-prose h2 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    color: #1a1f2e;
    margin-bottom: 1rem;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .legal-prose h2 .legal-num {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: #b8943f;
    flex-shrink: 0;
    transform: translateY(-1px);
  }

  .legal-prose h3 {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 700;
    color: #1a1f2e;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .legal-prose p {
    font-size: 1rem;
    line-height: 1.75;
    color: #40465a;
    margin-bottom: 1rem;
  }

  .legal-prose ul {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }

  .legal-prose li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 1rem;
    line-height: 1.75;
    color: #40465a;
    margin-bottom: 0.5rem;
  }

  .legal-prose li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: #b8943f;
    transform: rotate(45deg);
  }

  .legal-prose strong {
    font-weight: 700;
    color: #1a1f2e;
  }

  .legal-prose a {
    color: #b8943f;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid rgba(184, 148, 63, 0.35);
    transition: border-color 0.2s;
  }

  .legal-prose a:hover {
    border-bottom-color: #b8943f;
  }

  /* Callout — used for the clauses carriers specifically look for. */
  .legal-prose .legal-callout {
    background: #ffffff;
    border: 1px solid var(--color-card-border);
    border-left: 3px solid #b8943f;
    border-radius: 8px;
    padding: 1.5rem 1.75rem;
    margin: 1.5rem 0;
    box-shadow: 0 1px 3px rgba(26, 31, 46, 0.04);
  }

  .legal-prose .legal-callout p:last-child {
    margin-bottom: 0;
  }

  .legal-prose .legal-callout p {
    color: #1a1f2e;
  }

  /* Definition rows — label / value pairs for program facts. */
  .legal-prose dl {
    margin: 1rem 0;
    display: grid;
    gap: 0;
  }

  .legal-prose dt {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #5a6070;
    padding-top: 1rem;
    border-top: 1px solid var(--color-card-border);
  }

  .legal-prose dd {
    margin: 0.35rem 0 1rem;
    font-size: 1rem;
    line-height: 1.7;
    color: #40465a;
  }

  @media (min-width: 640px) {
    .legal-prose dl {
      grid-template-columns: 11rem 1fr;
    }

    .legal-prose dt {
      padding-top: 1rem;
    }

    .legal-prose dd {
      margin: 0;
      padding-top: 1rem;
      border-top: 1px solid var(--color-card-border);
    }
  }
</style>
